generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  nickname        String
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledgerMembers     LedgerMember[]
  transactions      Transaction[]
  notifications     Notification[]
  reminderSetting   ReminderSetting?
  spaces            UserSpace[]
  ledgerSpaces      LedgerSpace[]
}

// 账本
model Ledger {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("daily") // daily | loan | custom
  icon      String?
  color     String?
  currency  String   @default("CNY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      LedgerMember[]
  categories   Category[]
  transactions Transaction[]
  loans        Loan[]
  expensePlans ExpensePlan[]
  ledgerSpaces LedgerSpace[]
}

// 账本成员（家人共享）
model LedgerMember {
  id        String   @id @default(cuid())
  ledgerId  String
  userId    String
  role      String   @default("editor") // owner | editor | viewer
  createdAt DateTime @default(now())

  ledger Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, userId])
  @@index([userId])
}

// 类别（挂在账本下）
model Category {
  id        String  @id @default(cuid())
  ledgerId  String
  name      String
  type      String  @default("expense") // expense | income
  icon      String?
  color     String?
  sortOrder Int     @default(0)
  isBuiltin Boolean @default(false)

  ledger       Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  expensePlans ExpensePlan[]

  @@index([ledgerId])
}

// 流水
model Transaction {
  id         String   @id @default(cuid())
  ledgerId   String
  categoryId String?
  userId     String
  type       String   @default("expense") // expense | income | transfer
  amount     Decimal  @db.Decimal(12, 2)
  note                String?
  occurredAt          DateTime
  loanId              String? // 关联贷款（贷款产生的流水，用于提前还款时定位删除）
  expensePlanId       String? // 关联支出计划（创建计划时生成的支出流水）
  expensePlanPeriodId String? // 关联支出计划期（标记已支出/撤销时精确定位流水）
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ledger             Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category           Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan               Loan?             @relation(fields: [loanId], references: [id], onDelete: SetNull)
  expensePlan        ExpensePlan?      @relation(fields: [expensePlanId], references: [id], onDelete: SetNull)
  expensePlanPeriod  ExpensePlanPeriod? @relation(fields: [expensePlanPeriodId], references: [id], onDelete: SetNull)

  @@index([ledgerId, occurredAt])
  @@index([userId])
  @@index([loanId])
  @@index([expensePlanId])
  @@index([expensePlanPeriodId])
}

// 贷款
model Loan {
  id              String   @id @default(cuid())
  ledgerId        String
  name            String
  direction       String   @default("borrow") // borrow 我借出(应收) | lend 我借入(应还)
  principal       Decimal  @db.Decimal(14, 2)
  annualRate      Decimal  @db.Decimal(6, 4) // 年利率%，如 4.9
  startDate       DateTime @db.Date
  termMonths      Int
  repaymentDay    Int      @default(1) // 每月还款日 1-31
  repaymentMethod String   @default("equal_installment") // equal_installment | equal_principal | interest_first | custom
  status          String   @default("active") // active | paid_off | closed
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledger      Ledger           @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  repayments  LoanRepayment[]
  transactions Transaction[]

  @@unique([ledgerId, name])
  @@index([ledgerId])
}

// 还款计划（摊销表）
model LoanRepayment {
  id              String   @id @default(cuid())
  loanId          String
  periodNo        Int
  kind            String   @default("period") // period | prepay
  dueDate         DateTime @db.Date
  principalAmount Decimal  @db.Decimal(14, 2)
  interestAmount  Decimal  @db.Decimal(14, 2)
  totalAmount     Decimal  @db.Decimal(14, 2)
  paidAmount      Decimal  @db.Decimal(14, 2) @default(0)
  status          String   @default("pending") // pending | partial | paid | overdue
  paidDate        DateTime? @db.Date
  note            String?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, periodNo])
  @@index([dueDate])
}

// 支出计划（长期支出，如女儿生活费。镜像贷款，创建即生成全部期流水）
model ExpensePlan {
  id           String   @id @default(cuid())
  ledgerId     String
  categoryId   String // 支出类别（用户自选，不按计划名自动建）
  name         String
  periodAmount Decimal  @db.Decimal(12, 2) // 每期金额
  termCount    Int      @default(0) // 期数，0 = 不限（生成 120 期）
  frequency    String   @default("month") // month | quarter | year
  startDate    DateTime @db.Date
  day          Int      @default(1) // 每周期扣款日 1-31（季/年默认 = startDate 的 day）
  status       String   @default("active") // active | completed | closed
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ledger       Ledger              @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category     Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict) // 类别被计划引用时不可删
  periods      ExpensePlanPeriod[]
  transactions Transaction[]

  @@unique([ledgerId, name])
  @@index([ledgerId])
}

// 支出计划期
model ExpensePlanPeriod {
  id       String   @id @default(cuid())
  planId   String
  periodNo Int
  dueDate  DateTime @db.Date
  amount   Decimal  @db.Decimal(12, 2)
  status   String   @default("pending") // pending | paid
  paidDate DateTime? @db.Date
  note     String?

  plan          ExpensePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([planId, periodNo])
  @@index([dueDate])
}

// 用户空间（个人私有分组；默认分组 = 无 LedgerSpace 记录）
model UserSpace {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?
  color     String?
  createdAt DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerSpaces LedgerSpace[]

  @@unique([userId, name])
  @@index([userId])
}

// 用户把某账本归到某空间（每用户每账本唯一；共享账本不产生记录，恒默认分组）
model LedgerSpace {
  id        String   @id @default(cuid())
  userId    String
  ledgerId  String
  spaceId   String
  createdAt DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger Ledger     @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  space  UserSpace  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, ledgerId])
  @@index([userId])
  @@index([ledgerId])
}

// 站内通知
model Notification {
  id            String   @id @default(cuid())
  userId        String
  type          String   @default("system") // loan_reminder | overdue | system
  title         String
  content       String
  relatedLoanId String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// 提醒设置（用户级）
model ReminderSetting {
  id           String  @id @default(cuid())
  userId       String  @unique
  leadDays     Int     @default(3)
  emailEnabled Boolean @default(false)
  email        String?
  inappEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)
  remindTime   String  @default("08:00")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 操作日志（记录修改/删除）
model AuditLog {
  id        String   @id @default(cuid())
  ledgerId  String
  userId    String
  action    String   // update | delete
  entity    String   // 模型名，如 Transaction / Loan / Category
  entityId  String
  summary   String   // 人类可读描述
  before    String?  @db.Text // 改前 / 被删内容的 JSON
  after     String?  @db.Text // 改后内容的 JSON
  createdAt DateTime @default(now())

  @@index([ledgerId, createdAt])
  @@index([entity, entityId])
}
